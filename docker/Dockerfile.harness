# Multi-distro base image:
# - Default keeps Jazzy pinned for reproducibility.
# - Override ROS_BASE_IMAGE (and ROS_DISTRO) for other distros, e.g. Humble.
ARG ROS_BASE_IMAGE=ros:jazzy-ros-base-noble@sha256:af9454f13d342c58bb9f3364424e3e7026184e59a47de75f915d241cb7ec6666
ARG ROS_DISTRO=jazzy
FROM ${ROS_BASE_IMAGE}
ARG ROS_DISTRO

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    cmake \
    python3-colcon-common-extensions \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install ROS lifecycle packages (needed for backend_prod lifecycle ops)
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-lifecycle \
    ros-${ROS_DISTRO}-lifecycle-msgs \
    ros-${ROS_DISTRO}-test-msgs \
    && rm -rf /var/lib/apt/lists/*

# Python backend support (rclpy comes from ros-${ROS_DISTRO} packages)
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-setuptools \
    ros-${ROS_DISTRO}-rclpy \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /work
COPY . /work

# Build backend_prod for peer binaries (sequence_actor needed by backend_py)
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --packages-select backend_prod --cmake-args -DCMAKE_BUILD_TYPE=Release

# Install backend_py package (editable mode for development).
# Humble images may ship pip that does not support --break-system-packages.
RUN cd harness/backends/backend_py && (pip3 install -e . --break-system-packages || pip3 install -e .)

ENV ORACLE_BACKEND=prod
