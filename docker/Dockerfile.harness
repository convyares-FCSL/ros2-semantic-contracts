# Pinned base image for reproducible builds (see docs/harness/RELIABILITY_RULES.md)
# To update: docker pull ros:jazzy-ros-base-noble && docker inspect --format='{{index .RepoDigests 0}}' ros:jazzy-ros-base-noble
FROM ros:jazzy-ros-base-noble@sha256:af9454f13d342c58bb9f3364424e3e7026184e59a47de75f915d241cb7ec6666

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    cmake \
    python3-colcon-common-extensions \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install ROS lifecycle packages (needed for backend_prod lifecycle ops)
RUN apt-get update && apt-get install -y \
    ros-jazzy-lifecycle \
    ros-jazzy-lifecycle-msgs \
    ros-jazzy-test-msgs \
    && rm -rf /var/lib/apt/lists/*

# Python backend support (rclpy comes from ros-jazzy packages)
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-setuptools \
    ros-jazzy-rclpy \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /work
COPY . /work

# Build backend_prod for peer binaries (sequence_actor needed by backend_py)
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --packages-select backend_prod --cmake-args -DCMAKE_BUILD_TYPE=Release

# Install backend_py package (editable mode for development)
RUN cd harness/backends/backend_py && pip3 install -e . --break-system-packages

ENV ORACLE_BACKEND=prod
