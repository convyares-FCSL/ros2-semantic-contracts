            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "ordered_param",
                        "value": "v0"
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "ordered_param",
                        "type": "string",
                        "value": "v1"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "ordered_param"
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "ordered_param",
                        "type": "string",
                        "value": "v2"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "ordered_param"
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "ordered_param",
                        "type": "string",
                        "value": "v3"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "ordered_param"
                    }
                }
