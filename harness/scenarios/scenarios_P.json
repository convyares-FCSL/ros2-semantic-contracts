{
    "version": "0.1",
    "group": "P",
    "description": "Skeleton scenarios generated from traceability.md (grouped, keyed by scenario id).",
    "scenarios": {
        "P01_no_fabricated_params": {
            "spec_id": "P01",
            "title": "No fabricated parameters",
            "layer": "Core",
            "requires": [
                "ros.params.get",
                "ros.params.declare"
            ],
            "notes": "Validates SPEC_PC01/SPEC_PC02 baseline at query boundary: unknown parameters must remain undeclared/NOT_SET, and parameter identity is case-sensitive (no fabricated alias).",
            "ops": [
                {
                    "op": "get_param",
                    "payload": {
                        "name": "ghost_param"
                    }
                },
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "CaseParam"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "caseparam"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "CaseParam"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "ghost_param",
                                    "declared": false,
                                    "set": false,
                                    "type": "NOT_SET"
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "CaseParam",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "caseparam",
                                    "declared": false,
                                    "set": false,
                                    "type": "NOT_SET"
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "CaseParam",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": ""
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P02_dynamic_typing_rules": {
            "spec_id": "P02",
            "title": "Dynamic typing rules",
            "layer": "Core",
            "requires": [
                "ros.params.declare",
                "ros.params.set",
                "ros.params.get"
            ],
            "notes": "Validates SPEC_PC03: static parameters reject incompatible type updates, while dynamic parameters permit type changes. Verifies state remains unchanged for static rejection and transitions to new type/value for dynamic acceptance.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "static_typed_param",
                        "value": "initial_static"
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "static_typed_param",
                        "type": "integer",
                        "value": 42
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "static_typed_param"
                    }
                },
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "dynamic_typed_param",
                        "value": "initial_dynamic",
                        "descriptor": {
                            "dynamic_typing": true
                        }
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "dynamic_typed_param",
                        "type": "integer",
                        "value": 42
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "dynamic_typed_param"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "static_typed_param",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_param",
                                    "name": "static_typed_param",
                                    "successful": false
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "static_typed_param",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": "initial_static"
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "dynamic_typed_param",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_param",
                                    "name": "dynamic_typed_param",
                                    "successful": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "dynamic_typed_param",
                                    "declared": true,
                                    "set": true,
                                    "type": "integer",
                                    "value": 42
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P03_redeclaration_fails": {
            "spec_id": "P03",
            "title": "Redeclaration fails",
            "layer": "Core",
            "requires": [
                "ros.params.declare"
            ],
            "notes": "Declaring the same parameter twice must fail deterministically. Outcomes recorded in op_end.detail; second declare triggers rclcpp ParameterAlreadyDeclaredException.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "test_redeclare_param"
                    }
                },
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "test_redeclare_param"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "test_redeclare_param",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "test_redeclare_param",
                                    "declared": false,
                                    "reason": "AlreadyDeclared"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P04_no_partial_application": {
            "spec_id": "P04",
            "title": "No partial application",
            "layer": "Core",
            "requires": [
                "ros.params.set_batch",
                "ros.params.declare",
                "ros.params.get"
            ],
            "notes": "Atomic batch-set with one undeclared param must reject entirely. Uses set_parameters_atomically; state verified with get_param before/after. Both params remain unchanged on rejection. Validates SPEC_PC05+SPEC_P04 atomicity.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "valid_param"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "valid_param"
                    }
                },
                {
                    "op": "set_params_batch",
                    "payload": {
                        "params": [
                            {
                                "name": "valid_param",
                                "value": "foo",
                                "type": "string"
                            },
                            {
                                "name": "undeclared_param",
                                "value": "bar",
                                "type": "string"
                            }
                        ]
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "valid_param"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "valid_param",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "valid_param",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": ""
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_params_batch",
                                    "successful": false
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "valid_param",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": ""
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P05_readonly_enforcement": {
            "spec_id": "P05",
            "title": "Read-only enforcement",
            "layer": "Core",
            "requires": [
                "ros.params.declare",
                "ros.params.set",
                "ros.params.get"
            ],
            "notes": "Validates SPEC_PC05: parameters declared read-only cannot be modified. Descriptor with read_only=true passed to declare_param; subsequent set_param must fail and leave value unchanged.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "readonly_test",
                        "value": "initial",
                        "descriptor": {
                            "read_only": true
                        }
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "readonly_test"
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "readonly_test",
                        "type": "string",
                        "value": "modified"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "readonly_test"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "readonly_test",
                                    "declared": true,
                                    "descriptor": {
                                        "read_only": true
                                    }
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "readonly_test",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": "initial"
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_param",
                                    "name": "readonly_test",
                                    "successful": false
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "readonly_test",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": "initial"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P06_unknown_params_rejected": {
            "spec_id": "P06",
            "title": "Unknown params rejected",
            "layer": "Core",
            "requires": [
                "ros.params.set"
            ],
            "notes": "Setting an undeclared parameter must be rejected by the node. Outcome recorded in op_end.detail; node is constructed with allow_undeclared_parameters(false) pinned in NodeOptions.",
            "ops": [
                {
                    "op": "set_param",
                    "payload": {
                        "name": "param_does_not_exist",
                        "type": "integer",
                        "value": 42
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_param",
                                    "name": "param_does_not_exist",
                                    "successful": false
                                }
                            }
                        ]
                    }
                }
            ]
        },
