        "P03_redeclaration_fails": {
            "spec_id": "P03",
            "title": "Redeclaration fails",
            "layer": "Core",
            "requires": [
                "ros.params.declare"
            ],
            "notes": "Declaring the same parameter twice must fail deterministically. Outcomes recorded in op_end.detail; second declare triggers rclcpp ParameterAlreadyDeclaredException.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "test_redeclare_param"
                    }
                },
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "test_redeclare_param"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "test_redeclare_param",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "test_redeclare_param",
                                    "declared": false,
                                    "reason": "AlreadyDeclared"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P04_no_partial_application": {
            "spec_id": "P04",
            "title": "No partial application",
            "layer": "Core",
            "requires": [
                "ros.params.set_batch",
                "ros.params.declare",
                "ros.params.get"
            ],
            "notes": "Atomic batch-set with one undeclared param must reject entirely. Uses set_parameters_atomically; state verified with get_param before/after. Both params remain unchanged on rejection. Validates SPEC_PC05+SPEC_P04 atomicity.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "valid_param"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "valid_param"
                    }
                },
                {
                    "op": "set_params_batch",
                    "payload": {
                        "params": [
                            {
                                "name": "valid_param",
                                "value": "foo",
                                "type": "string"
                            },
                            {
                                "name": "undeclared_param",
                                "value": "bar",
                                "type": "string"
                            }
                        ]
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "valid_param"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "valid_param",
                                    "declared": true
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "valid_param",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": ""
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_params_batch",
                                    "successful": false
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "valid_param",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": ""
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "P05_readonly_enforcement": {
            "spec_id": "P05",
            "title": "Read-only enforcement",
            "layer": "Core",
            "requires": [
                "ros.params.declare",
                "ros.params.set",
                "ros.params.get"
            ],
            "notes": "Validates SPEC_PC05: parameters declared read-only cannot be modified. Descriptor with read_only=true passed to declare_param; subsequent set_param must fail and leave value unchanged.",
            "ops": [
                {
                    "op": "declare_param",
                    "payload": {
                        "name": "readonly_test",
                        "value": "initial",
                        "descriptor": {
                            "read_only": true
                        }
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "readonly_test"
                    }
                },
                {
                    "op": "set_param",
                    "payload": {
                        "name": "readonly_test",
                        "type": "string",
                        "value": "modified"
                    }
                },
                {
                    "op": "get_param",
                    "payload": {
                        "name": "readonly_test"
                    }
                }
            ],
            "expects": [
                {
                    "check": "custom",
                    "params": {
                        "must_observe": [
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "declare_param",
                                    "name": "readonly_test",
                                    "declared": true,
                                    "descriptor": {
                                        "read_only": true
                                    }
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "readonly_test",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": "initial"
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "set_param",
                                    "name": "readonly_test",
                                    "successful": false
                                }
                            },
                            {
                                "type": "op_end",
                                "detail": {
                                    "op": "get_param",
                                    "name": "readonly_test",
                                    "declared": true,
                                    "set": true,
                                    "type": "string",
                                    "value": "initial"
                                }
                            }
                        ]
                    }
                }
            ]
        },
