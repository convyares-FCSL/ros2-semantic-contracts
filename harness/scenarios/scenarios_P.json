        "P12_describe_unknown_consistent": {
            "spec_id": "P12",
            "title": "Describe Unknown Consistent",
            "layer": "Core",
            "requires": [
                "ros.params.describe"
            ],
            "notes": "Validates SPEC_P06: calling describe_param twice on the same unknown parameter must return identical descriptor fields. Consistency defined as: type, read_only, dynamic_typing fields must match across calls. Note: rclcpp throws on undeclared params, so we catch and fabricate a default descriptor.",
            "ops": [
                {
                    "op": "describe_param",
                    "payload": {
                        "name": "param_does_not_exist"
                    }
                },
                {
