{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Oracle scenario bundle (v0.1)",
    "type": "object",
    "required": [
        "version",
        "group",
        "scenarios"
    ],
    "properties": {
        "version": {
            "type": "string"
        },
        "group": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        },
        "scenarios": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "type": "string",
                "pattern": "^[A-Z]\\d{2}_[A-Za-z0-9_]+$"
            },
            "additionalProperties": {
                "type": "object",
                "required": [
                    "spec_id",
                    "title",
                    "ops",
                    "expects"
                ],
                "properties": {
                    "spec_id": {
                        "type": "string",
                        "pattern": "^[A-Z]\\d{2}$"
                    },
                    "title": {
                        "type": "string"
                    },
                    "layer": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "node_options": {
                        "type": "object",
                        "description": "Optional backend node construction options (e.g. parameter overrides for startup-path probes)."
                    },
                    "ops": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "op"
                            ],
                            "properties": {
                                "op": {
                                    "type": "string",
                                    "enum": [
                                        "start_actor",
                                        "stop_actor",
                                        "send_goal",
                                        "wait",
                                        "emit_feedback",
                                        "emit_status",
                                        "emit_result",
                                        "request_cancel",
                                        "set_param",
                                        "set_param_atomic",
                                        "get_param",
                                        "declare_param",
                                        "undeclare_param",
                                        "set_params_batch",
                                        "set_params_non_atomic",
                                        "register_param_callback",
                                        "register_pre_set_callback",
                                        "observe_param_events",
                                        "list_params",
                                        "get_parameter_types",
                                        "concurrent_read_during_batch",
                                        "probe_startup_declare_events",
                                        "probe_startup_manual_declare_events",
                                        "probe_cli_typed_no_default_declare",
                                        "call_service",
                                        "describe_param"
                                    ]
                                },
                                "ms": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "For wait or timeouts (milliseconds)."
                                },
                                "goal_id": {
                                    "type": "string",
                                    "description": "Logical goal id (scenario-local)."
                                },
                                "payload": {
                                    "type": "object"
                                }
                            },
                            "additionalProperties": true,
                            "allOf": [
                                {
                                    "not": {
                                        "properties": {
                                            "op": {
                                                "const": "assert"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "expects": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "check"
                            ],
                            "properties": {
                                "check": {
                                    "type": "string",
                                    "enum": [
                                        "custom",
                                        "absent",
                                        "status_monotonic",
                                        "describe_unknown_consistent"
                                    ]
                                },
                                "within_ms": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "selector": {
                                    "type": "object",
                                    "description": "How to select relevant events from the trace."
                                },
                                "params": {
                                    "type": "object"
                                }
                            },
                            "additionalProperties": true
                        }
                    }
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": false
}
